<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AppInsegura</RootNamespace>
    <AssemblyName>AppInsegura</AssemblyName>
  </PropertyGroup>

  <!--
    NOTA PARA EL ALUMNADO:
    En un proyecto real, aquí aparecería normalmente una lista de paquetes
    NuGet (<PackageReference>). Es habitual encontrar proyectos que siguen
    usando versiones muy antiguas de una dependencia, con vulnerabilidades
    ya conocidas y corregidas en versiones más recientes. Este proyecto no
    usa ningún paquete externo para que puedas compilarlo sin conexión,
    pero es un punto más a tener en cuenta al auditar una aplicación real.
  -->

</Project>
